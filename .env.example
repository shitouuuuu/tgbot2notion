# ==========================================
# Telegram Bot 配置
# ==========================================
# 通过 Telegram @BotFather 获取
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# 允许使用该 Bot 的 Telegram 用户 ID（数字 ID，通过 @userinfobot 查询）
# 多个 ID 请用英文逗号分隔，如: 12345678,87654321
ALLOWED_USER_IDS=12345678

# ==========================================
# Notion 配置
# ==========================================
# 在 https://www.notion.so/my-integrations 创建 Internal Integration 获取 Secret
NOTION_TOKEN=secret_your_notion_integration_token_here

# 目标 Notion 数据库 ID（32 位字符串）
# 格式示例: https://www.notion.so/workspace/{DATABASE_ID}?v=...
NOTION_DATABASE_ID=your_notion_database_id_here

# ==========================================
# 可选网络代理配置（非必填，若服务器访问 TG 或 IG 受限时配置）
# ==========================================
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
